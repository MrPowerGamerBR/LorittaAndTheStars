<object>
  <spriteName>spr_ball</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>0</depth>
  <persistent>0</persistent>
  <parentName>obj_solid_base</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// I have no idea why we need to do this when obj_loritta is present
if (!instance_exists(obj_loritta)) exit;

var newX = self.x;
var newY = self.y;

if (obj_loritta.elapsedTicks % 10 == 0) {
    if (self.moving == 0) {
       newX -= 20;
    } else if (self.moving == 1) {
       newX += 20;
    } else if (self.moving == 2) {
       newY -= 20;
    } else {
       newY += 20;
    }
}


var breakableWall = instance_place(newX, newY, obj_breakable_wall);

if (breakableWall != noone) {
    with (breakableWall) {
        instance_destroy();
    }
    audio_play_sound(snd_break_wall, 1, false);
}

if (place_meeting(newX, newY, obj_solid_base)) {
    // Hit something: reverse direction instead of moving
    if (moving == 0) moving = 1;        // left  -&gt; right
    else if (moving == 1) moving = 0;   // right -&gt; left
    else if (moving == 2) moving = 3;   // up    -&gt; down
    else moving = 2;                    // down  -&gt; up
} else {
    x = newX;
    y = newY;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsObject>0</PhysicsObject>
  <PhysicsObjectSensor>0</PhysicsObjectSensor>
  <PhysicsObjectShape>0</PhysicsObjectShape>
  <PhysicsObjectDensity>0.5</PhysicsObjectDensity>
  <PhysicsObjectRestitution>0.100000001490116</PhysicsObjectRestitution>
