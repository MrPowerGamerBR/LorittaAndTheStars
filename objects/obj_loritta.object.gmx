<object>
  <spriteName>spr_loritta_down</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-1</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>self.gotRedKey = false;
self.gotYellowKey = false;
self.gotBlueKey = false;
self.gotGreenKey = false;
self.movedOnce = false;
self.elapsedTicks = 0;
image_speed = 0.05;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>var cx = x - sprite_xoffset + (sprite_width / 2);
var cy = y - sprite_yoffset + (sprite_height / 2);

view_xview[0] = cx - (view_wview[0] / 2);
view_yview[0] = cy - (view_hview[0] / 2);

view_xview[0] = clamp(view_xview[0], 0, room_width - view_wview[0]);
view_yview[0] = clamp(view_yview[0], 0, room_height - view_hview[0]);

self.elapsedTicks++;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (keyboard_check_pressed(ord('C'))) {
    room_restart();
    exit;
}

var newX = x;
var newY = y;

var ball = instance_place(newX, newY, obj_ball);

if (ball != noone) {
   room_restart();
   exit;
}

var speedRight = instance_place(newX, newY, obj_speed_right);
var speedUp = instance_place(newX, newY, obj_speed_up);
var speedDown = instance_place(newX, newY, obj_speed_down);
var speedLeft = instance_place(newX, newY, obj_speed_left);

var onASpeedTile = false;

if (speedRight != noone) {
    newX += 20;
    onASpeedTile = true;
}

if (speedUp != noone) {
    newY -= 20;
    onASpeedTile = true;
}

if (speedDown != noone) {
    newY += 20;
    onASpeedTile = true;
}

if (speedLeft != noone) {
    newX -= 20;
    onASpeedTile = true;
}

if (!onASpeedTile) {
    if (keyboard_check_pressed(vk_left)) {
        newX -= 20;
    } else if (keyboard_check_pressed(vk_right)) {
        newX += 20;
    } else if (keyboard_check_pressed(vk_up)) {
        newY -= 20;
    } else if (keyboard_check_pressed(vk_down)) {
        newY += 20;
    }
}

var directionX = newX - x;
var directionY = newY - y;

var wall = instance_place(newX, newY, obj_solid_base);

if (wall != noone) {
    if (wall.object_index == obj_wall_red_key &amp;&amp; self.gotRedKey) {
        audio_play_sound(snd_open_key, 1, false);
        with (wall) {
            instance_destroy();
        }
    } else if (wall.object_index == obj_wall_green_key &amp;&amp; self.gotGreenKey) {
        audio_play_sound(snd_open_key, 1, false);
        with (wall) {
            instance_destroy();
        }
    } else if (wall.object_index == obj_wall_yellow_key &amp;&amp; self.gotYellowKey) {
        audio_play_sound(snd_open_key, 1, false);
        with (wall) {
            instance_destroy();
        }
    } else if (wall.object_index == obj_wall_blue_key &amp;&amp; self.gotBlueKey) {
        audio_play_sound(snd_open_key, 1, false);
        with (wall) {
            instance_destroy();
        }
    } else if (wall.object_index == obj_box) {
        var pushed = false;
        with (wall) {
            // here "self" is the box; dx/dy are still the player's locals
            var blockedBlock = instance_place(x + directionX, y + directionY, all);
            if (blockedBlock == noone || blockedBlock.object_index == obj_speed_right || blockedBlock.object_index == obj_speed_left || blockedBlock.object_index == obj_speed_up || blockedBlock.object_index == obj_speed_down) {
                x += directionX;
                y += directionY;
                pushed = true;
                audio_play_sound(snd_push, 1, false);
            }
            
            if (blockedBlock.object_index == obj_water) {
                instance_destroy();
                with (blockedBlock) {
                    instance_destroy();
                }
                pushed = true;
                audio_play_sound(snd_water, 1, false);
            }
        }
        if (!pushed) {
            // Box is blocked -&gt; player stays put
            newX = x;
            newY = y;
        }
    } else {
        newX = self.x;
        newY = self.y;
    }
}

var star = instance_place(newX, newY, obj_star);
if (star != noone) {
    with (star) {
        instance_destroy();
    }
    audio_play_sound(snd_star, 1, false);
    
    if (instance_number(obj_star) == 0) {
        room_goto_next();
    }
}

var key = instance_place(newX, newY, obj_key_base);
if (key != noone) {
    if (key.object_index == obj_red_key) {
        self.gotRedKey = true;
    }
    if (key.object_index == obj_blue_key) {
        self.gotBlueKey = true;
    }
    if (key.object_index == obj_yellow_key) {
        self.gotYellowKey = true;
    }
    if (key.object_index == obj_green_key) {
        self.gotGreenKey = true;
    }
    
    audio_play_sound(snd_key, 1, false);
    
    with (key) {
        instance_destroy();
    }
}

if (directionY &gt; 0) {
    sprite_index = spr_loritta_down;
    self.movedOnce = true;
} else if (0 &gt; directionY) {
    sprite_index = spr_loritta_up;
    self.movedOnce = true;
} else if (directionX &gt; 0) {
    sprite_index = spr_loritta_right;
    self.movedOnce = true;
} else if (0 &gt; directionX) {
    sprite_index = spr_loritta_left;
    self.movedOnce = true;
}

self.x = newX;
self.y = newY;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_self();

if (!self.movedOnce) {
    draw_set_font(fnt_opensanspx);
    
    var text = "THIS SHOULD NEVER HAPPEN!"
    
    switch (room) {
        case rm_level1:
            text = "Level 1"
            break;
        case rm_level2:
            text = "Level 2"
            break;
        case rm_level3:
            text = "Level 3"
            break;
        case rm_level4:
            text = "Level 4"
            break;
        case rm_level5:
            text = "Level 5"
            break;
        case rm_level6:
            text = "Level 6"
            break;
        case rm_level7:
            text = "Level 7"
            break;
        case rm_level8:
            text = "Level 8"
            break;
        case rm_level9:
            text = "Level 9"
            break;
    }
    
    var height = string_height(text);
    var length = string_width(text);
    
    scr_draw_text_outlined(
        view_xview[0] + (view_wview[0] / 2) - (length / 2),
        view_yview[0] + 20,
        c_white,
        c_black,
        text
    );
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
